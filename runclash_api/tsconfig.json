{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "isolatedModules": true
  },
  "include": ["src/**/*", "index.ts", "jest.setup.ts"],
  "exclude": ["node_modules", "dist", "revision", "scripts"]
}
